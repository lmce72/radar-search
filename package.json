{
  "name": "radar-search",
  "version": "1.5.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test --timeout 5000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "check": "bun run typecheck && bun run lint && bun scripts/check.ts",
    "release:check": "bun scripts/release-check.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "description": "Universal search for Obsidian: notes, commands, properties, links and the web.",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmce72/radar-search.git"
  },
  "homepage": "https://github.com/lmce72/radar-search",
  "bugs": {
    "url": "https://github.com/lmce72/radar-search/issues"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "search",
    "full-text-search",
    "typescript",
    "cjk"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/picomatch": "4.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "dependencies": {
    "picomatch": "4.0.7"
  }
}
